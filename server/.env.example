# Copy to server/.env for local development. On Render, set these in the dashboard.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=agencydesk
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Protects POST /api/cron (Render Cron Job / external scheduler)
CRON_SECRET=
# Public URL of the app — used in invite and password-reset emails
APP_URL=http://localhost:4000
# Optional email (https://resend.com): invites, password resets, emailed reminders, leave notifications
RESEND_API_KEY=
EMAIL_FROM=
# Only needed if a frontend on another domain calls the API directly (not needed with the Vercel proxy)
ALLOWED_ORIGINS=
MAX_UPLOAD_MB=10
TZ=Asia/Kolkata
PORT=4000
